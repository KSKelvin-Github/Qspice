  «text (0,-400) 1 0 0 0x1000000 -1 -1 "x_init=<(0),1> ;Initial state"»
  «text (0,-550) 1 0 2 0x1000000 -1 -1 "thre=<0.5> ;logic threshold"»
  «text (0,-700) 1 0 2 0x1000000 -1 -1 "restricted=<(-1),0,1> ; -1:LastStateDominate ; 0:ResetDominate ; 1:SetDominate"»
