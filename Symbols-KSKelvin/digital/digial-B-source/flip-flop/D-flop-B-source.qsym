  «text (0,550) 1 0 2 0x1000000 -1 -1 "D-FLOP-B-SOURCE"»
  «text (0,-400) 1 0 2 0x1000000 -1 -1 "trigger=<0> ;Trigger 0: rising, 1:falling"»
