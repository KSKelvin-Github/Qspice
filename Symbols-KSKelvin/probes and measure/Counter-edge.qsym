ÿØÿÛ«symbol Counter-edge
  «type: X»
  «description: Edge Counter (return rising/falling/both edge count)»
  «library file: |.subckt Counter-edge in latch count\nB1 latchR 0 V=rising_thres(V(in),thres)\nB2 latchF 0 V=falling_thres(V(in),thres)\nB3 latch 0 V=if(mode==-1,V(latchF),if(mode==1,V(latchR),V(latchF)|V(latchR)))\nB4 count 0 V=V(latch)+state(1,V(count))\n.func rising_thres(x,thres) = if(state(1,x)<thres & thres<=x,1,0)\n.func falling_thres(x,thres) = if(state(1,x)>thres & thres>=x,1,0)\n.ends Counter-edge»
  «shorted pins: false»
  «rect (-400,-400) (400,400) 0 0 0 0xff0000 0xffe6c8 -1 0 -1»
  «text (0,650) 1 0 0 0x1000000 -1 -1 "X1"»
  «text (0,500) 1 0 0 0x1000000 -1 -1 "Counter-Edge"»
  «text (-400,-500) 1 7 0 0x1000000 -1 -1 "mode=<-1;[falling],0;[both],(1;[rising])>"»
  «text (-400,-650) 1 7 0 0x1000000 -1 -1 "thres=<0.5> threshold (V)"»
  «pin (-400,200) (20,0) 1 7 0 0x0 -1 "in"»
  «pin (400,-200) (-20,0) 1 11 0 0x0 -1 "latch"»
  «pin (400,200) (-20,0) 1 11 0 0x0 -1 "count"»
